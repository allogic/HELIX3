	(text "R_{FB1} || R_{FB2} = (R_{FB1} * 100) / (R_{FB2} + 100)\nt_{ON,NOM} = V_{OUT} / (V_{IN,NOM} * F_{SW})\n\n  C_{A} >= 10 / (F_{SW}(Hz) * (R_{FB1} || R_{FB2}))\nR_{A}C_{A} >= ((V_{IN,NOM} - V_{OUT}) * t_{ON,NOM}) / 20mV\n  C_{B} >= t_{TR,settling} / (3 * R_{FB1})"
		(exclude_from_sim no)
		(at 134.112 118.11 0)
